/* docs shell — persistent CTA bar above embedded Scalar. Append to globals.css.
   Uses the same design tokens as the dashboard (--bg/--border/--muted/--fg); swap
   for the target project's tokens or literal colors. The shell is a full-height
   flex column: a fixed CTA header + Scalar filling the rest with its own scroll. */
.docs-shell { display: flex; flex-direction: column; height: 100vh; }
.docs-cta {
  display: flex; align-items: center; gap: 18px;
  padding: 10px 18px; background: var(--bg);
  border-bottom: 1px solid var(--border); flex: 0 0 auto;
}
.docs-cta-link {
  color: var(--muted); font-size: 13px; text-decoration: none;
  transition: color 0.15s;
}
.docs-cta-link:hover { color: var(--fg); }
.docs-scalar { flex: 1 1 auto; min-height: 0; overflow: auto; }
