import { NextResponse } from 'next/server';
import { buildOpenApiDocument } from '../../../src/lib/openapi/document';
import { resolveDeployEnv } from '../../../src/lib/dashboard/deploy-info';

// GET /api/openapi.json — the generated OpenAPI 3 document that Scalar (/docs)
// reads. Served on local + dev deploys; 404s only on the prod deploy. Keyed on
// APP_ENV, not NODE_ENV — NODE_ENV is 'production' on every Docker deploy including
// dev, so keying on it would 404 the spec on the dev deploy and Scalar would fail
// to load ('Document could not be loaded'). Matches /docs and the /guide gate.
export async function GET() {
  if (resolveDeployEnv(process.env.APP_ENV) === 'prod') {
    return NextResponse.json({ error: 'not_found' }, { status: 404 });
  }
  return NextResponse.json(buildOpenApiDocument(), { status: 200 });
}
