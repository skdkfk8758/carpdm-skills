import type { ReactNode } from 'react';
import { notFound } from 'next/navigation';
import Link from 'next/link';
import { resolveDeployEnv } from '../../src/lib/dashboard/deploy-info';

// Force the /docs segment to render per-request so the APP_ENV gate below is
// evaluated at runtime, not baked at build time. /docs is now a PAGE (embedded
// Scalar), so it is statically prerenderable — without force-dynamic the gate
// would run at build (APP_ENV unset → local → open) and the static page would
// leak the docs on the prod deploy. Same pitfall as the /guide layout gate.
export const dynamic = 'force-dynamic';

// Docs shell: a persistent CTA bar above the embedded Scalar reference. Scalar
// takes over its whole container, so the only way to keep a visible "back to the
// guide / console" link while browsing endpoints is to wrap it in our own chrome —
// the OpenAPI info.description link only shows on the Introduction screen. Gate is
// keyed on APP_ENV (prod → 404), matching the /guide and /api/openapi.json policy.
export default function DocsLayout({ children }: { children: ReactNode }) {
  if (resolveDeployEnv(process.env.APP_ENV) === 'prod') {
    notFound();
  }

  return (
    <div className="docs-shell">
      <header className="docs-cta">
        <Link href="/guide" className="docs-cta-link">← 통합 가이드</Link>
        <Link href="/" className="docs-cta-link">운영 콘솔</Link>
      </header>
      <div className="docs-scalar">{children}</div>
    </div>
  );
}
