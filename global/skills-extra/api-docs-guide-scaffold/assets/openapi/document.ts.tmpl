// Builds the OpenAPI 3 document from the registry. The schema modules are imported
// for their side effect (registry.registerPath calls at module load) — without
// these imports the registry would be empty. Then OpenApiGeneratorV3 emits an
// OpenAPI 3.0.3 document covering every registered path + component.
import { OpenApiGeneratorV3 } from '@asteasolutions/zod-to-openapi';
import { registry } from './registry';

// Side-effecting registrations (paths + components). Order is irrelevant.
// Import every domain schema module here. The example ships with `auth`.
import './schemas/auth';

export function buildOpenApiDocument() {
  const generator = new OpenApiGeneratorV3(registry.definitions);
  return generator.generateDocument({
    openapi: '3.0.3',
    info: {
      title: '<APP_NAME> API — 통합 인증서버(IdP)',
      version: '0.0.1',
      description:
        // CTA back-links rendered by Scalar at the top of the Introduction — /docs
        // is otherwise a standalone takeover with no way back to the guide/console.
        '**[← 통합 가이드](/guide)** · **[운영 콘솔](/)**\n\n' +
        '통합 로그인 IdP API. 다른 내부 서비스가 사용자를 직접 인증하지 않고, 이 서버가 발급한 ' +
        '세션 쿠키 · SSO 티켓 · API Key 로 신원을 확인한다. 요청 검증과 이 OpenAPI 문서는 ' +
        '하나의 zod SSOT 에서 생성된다. 모든 실패 응답은 { error: "<code>" } 형태다. ' +
        '연동 방법(플로우·예제·함정)은 [통합 가이드](/guide)를 본다.',
    },
    // Base URLs surfaced in Scalar so the rendered curl / Test Request carry a real
    // host (otherwise the samples are path-only, e.g. `curl /api/auth/login`).
    servers: [
      { url: 'http://localhost:<PORT>', description: '로컬 dev (next dev)' },
      { url: 'https://<DEV_HOST>', description: 'dev 배포' },
      { url: 'https://<PROD_HOST>', description: 'prod 배포' },
    ],
  });
}
