// Deploy stamp source — version + environment shown in the dashboard sidebar.
// Both decisions are pure where possible so they can be unit-tested without a
// runtime: resolveDeployEnv maps a raw env string to a fixed union, getDeployInfo
// reads the build-time/runtime env vars and applies that mapping.

export type DeployEnv = 'dev' | 'prod' | 'local';

// Pure: map the raw APP_ENV value to a known environment. Anything that is not an
// exact 'dev' or 'prod' (unset, empty, unknown) safely falls back to 'local' — no
// crash, no throw.
export function resolveDeployEnv(raw: string | undefined): DeployEnv {
  if (raw === 'dev') return 'dev';
  if (raw === 'prod') return 'prod';
  return 'local';
}

export interface DeployInfo {
  version: string;
  env: DeployEnv;
}

// version comes from APP_VERSION (injected at build time from package.json via
// next.config.ts); '0.0.0' is the safe fallback when unset. env is resolved from
// the runtime APP_ENV through resolveDeployEnv.
export function getDeployInfo(): DeployInfo {
  return {
    version: process.env.APP_VERSION ?? '0.0.0',
    env: resolveDeployEnv(process.env.APP_ENV),
  };
}
