'use client';

// Guide section nav with active-link highlighting. Reuses the dashboard Sidebar's
// usePathname active pattern (exact match for the root, prefix match for sections).
import Link from 'next/link';
import { usePathname } from 'next/navigation';

type Section = { href: string; label: string };

// One entry per /guide/<slug>/page.mdx. Replace the example domain labels below
// with the sections this project ships (overview first, then scenarios).
const SECTIONS: Section[] = [
  { href: '/guide', label: '개요 · 시작하기' },
  { href: '/guide/quickstart', label: '빠른 시작 (end-to-end)' },
  { href: '/guide/<scenario-a>', label: '<시나리오 A>' },
  { href: '/guide/<scenario-b>', label: '<시나리오 B>' },
  { href: '/guide/<scenario-c>', label: '<시나리오 C>' },
];

export default function GuideNav() {
  const pathname = usePathname();

  function isActive(href: string): boolean {
    if (href === '/guide') return pathname === '/guide';
    return pathname === href || pathname.startsWith(href + '/');
  }

  return (
    <nav className="guide-nav" aria-label="통합 가이드 섹션">
      <div className="guide-nav-title">통합 가이드</div>
      {SECTIONS.map((s) => (
        <Link
          key={s.href}
          href={s.href}
          className={`guide-navlink${isActive(s.href) ? ' active' : ''}`}
        >
          {s.label}
        </Link>
      ))}
      <a className="guide-navlink ext" href="/docs" target="_blank" rel="noreferrer">
        API 레퍼런스 (/docs) ↗
      </a>
      <a className="guide-navlink ext" href="/" target="_blank" rel="noreferrer">
        운영 콘솔 (대시보드) ↗
      </a>
    </nav>
  );
}
