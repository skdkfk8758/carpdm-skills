import type { ReactNode } from 'react';
import { notFound } from 'next/navigation';
import { isGuideEnabled } from '../../src/lib/dashboard/guide-gate';
import GuideNav from './GuideNav';

// Force the whole /guide/* segment to render dynamically (per-request). Without
// this the MDX pages prerender as static HTML at BUILD time, where APP_ENV is
// unset (→ 'local' → gate open), and the runtime APP_ENV=prod check below never
// runs — so the gate leaks the guide on the prod deploy. Dynamic rendering makes
// the gate evaluate APP_ENV on every request, matching the /docs route handler.
export const dynamic = 'force-dynamic';

// Guide shell. The gate runs before any /guide/* child renders: on the prod
// deploy (APP_ENV==='prod') it 404s the whole route group — same policy as the
// Scalar /docs route, but applied at the layout so every nested page is covered.
// Keyed on APP_ENV so the guide stays visible on local + dev deploys. No operator
// login required (the guide is no-login, separate from the (dashboard) operator gate).
export default function GuideLayout({ children }: { children: ReactNode }) {
  if (!isGuideEnabled(process.env.APP_ENV)) {
    notFound();
  }

  return (
    <div className="guide-shell">
      <aside className="guide-aside">
        <GuideNav />
      </aside>
      <main className="guide-main">
        <article className="guide">{children}</article>
      </main>
    </div>
  );
}
