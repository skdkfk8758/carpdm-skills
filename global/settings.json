{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_LSP_TOOL": "1"
  },
  "permissions": {
    "allow": [
      "mcp__linear__save_comment",
      "mcp__linear__save_issue",
      "Bash(node:*)",
      "Bash(npm view:*)",
      "Bash(test:*)",
      "Bash(tree:*)",
      "Bash(pnpm:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm test:web:*)",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(bash:*)",
      "Bash(curl:*)",
      "Bash(claude plugins:*)",
      "Bash(git:*)",
      "Bash(git clone:*)",
      "Bash(git stash:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(pip3 list:*)",
      "Bash(ls:*)",
      "Bash(lsof:*)",
      "Bash(kill:*)",
      "Bash(find:*)",
      "Bash(cmux:*)",
      "Bash(playwright-cli:*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "Edit(~/.claude/skills/**)",
      "Bash(ssh gcp-nginx:*)",
      "Bash(ssh 4090_2WAY:*)",
      "Bash(ssh 4090_4WAY:*)",
      "Bash(ssh 4090_1WAY:*)",
      "Bash(ssh hermes:*)",
      "Bash(ssh -o ConnectTimeout=* gcp-nginx:*)",
      "Bash(ssh -o ConnectTimeout=* 4090_2WAY:*)",
      "Bash(ssh -o ConnectTimeout=* 4090_4WAY:*)",
      "Bash(ssh -o ConnectTimeout=* 4090_1WAY:*)",
      "Bash(ssh -o ConnectTimeout=* hermes:*)",
      "mcp__linear-intelligence__save_issue",
      "mcp__linear-intelligence__save_comment",
      "mcp__linear__list_teams",
      "mcp__linear__list_issues",
      "mcp__linear__get_issue",
      "mcp__linear__get_team",
      "mcp__linear__list_issue_statuses",
      "mcp__linear__list_comments",
      "Read(//Users/carpdm/.claude/linear-repo-map.json)",
      "Bash(gh pr create:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh repo view:*)",
      "Read(//Users/carpdm/.claude/skills/**)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guards/guard-branch-protection.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guards/guard-destructive-cmd.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guards/guard-worktree-remove.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guards/guard-branch-linear-naming.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guards/guard-worktree-edit-isolation.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__linear__save_issue",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guards/guard-linear-register-nudge.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/carpdm/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guards/guard-file-size.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guards/guard-claude-md-size.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guards/guard-html-mockup-artifact-nudge.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guards/guard-human-checklist-nudge.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guards/guard-linear-state-nudge.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guards/guard-acceptance-criteria-nudge.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guards/guard-verify-swallow.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/carpdm/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/caveman-session-start.sh",
            "timeout": 5,
            "statusMessage": "Loading caveman mode..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/linear-banner-autostart.sh",
            "timeout": 10,
            "statusMessage": "Linear auto-start check..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/carpdm/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/carpdm/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/carpdm/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/carpdm/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/carpdm/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/carpdm/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/carpdm/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/carpdm/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/carpdm/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head",
    "bgIsolation": "none"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "skill-creator@claude-plugins-official": true,
    "understand-anything@understand-anything": false,
    "claude-md-management@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "understand-anything": {
      "source": {
        "source": "github",
        "repo": "Lum1104/Understand-Anything"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "language": "korean",
  "effortLevel": "high",
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "environment": [
      "$defaults",
      "Source control: github.com/Team-DrafType (private org repos)",
      "Trusted SSH hosts (developer-owned infra): hermes, 4090_1WAY, 4090_2WAY, 4090_4WAY, gcp-nginx",
      "Hermes ingest/analyze daemon endpoints referenced via HERMES_INGEST_URL"
    ]
  }
}
